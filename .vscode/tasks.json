{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start MySQL Server",
      "type": "shell",
      "command": "& 'C:\\Program Files\\MySQL\\MySQL Server 8.0\\bin\\mysqld.exe' --datadir='${workspaceFolder}\\mysql_data' --port=3306 --console",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "services",
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Start Backend Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "services",
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Start Frontend Server",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "env": {
          "BROWSER": "none"
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "services",
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Run Entire Project",
      "dependsOn": [
        "Start MySQL Server",
        "Start Backend Server",
        "Start Frontend Server"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
